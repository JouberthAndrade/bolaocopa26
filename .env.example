# ─── Banco de dados (Neon / Supabase / Postgres local) ───
# DATABASE_URL: conexão da app (no Neon, host COM "-pooler").
DATABASE_URL="postgresql://user:password@localhost:5432/bolao?schema=public"
# DIRECT_URL: conexão direta usada por `prisma migrate deploy` (no Neon, host SEM "-pooler",
# = string "DATABASE_URL_UNPOOLED" do painel). Local: aponte para o mesmo banco da DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/bolao?schema=public"

# ─── Auth.js (NextAuth v5) ───
# Gere um segredo com: npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-forte"
# Em produção defina a URL pública (ex.: https://bolao2026.com)
# AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Football-Data.org (sync de jogos + finalização/pontuação) ───
# Competição Copa do Mundo: id 2000  (http://api.football-data.org/v4/competitions/)
FOOTBALL_DATA_TOKEN="IREI COLOCAR NO ENV"
FOOTBALL_DATA_COMPETITION_ID="2000"

# ─── API-Sports / api-sports.io (placar AO VIVO) ───
# Chave do dashboard (https://dashboard.api-sports.io/). Plano free: 10 req/min.
# Usada só por /api/cron/live-score; sem ela essa rota responde 500 (resto do app segue).
API_SPORTS_KEY=""
API_SPORTS_LEAGUE_ID="1"  # World Cup

# ─── Artilharia (top marcadores) ───
# Sem variáveis: a aba Artilharia é populada por /api/cron/sync-scorers via
# scraping da página pública da ESPN (sem chave / sem quota).

# ─── Cron (protege os endpoints /api/cron/*) ───
CRON_SECRET="troque-por-um-segredo-de-cron"
# Data (ISO 8601 UTC) a partir da qual o cron começa a sincronizar/pontuar.
# Antes disso a rota retorna cedo sem chamar a API. Padrão: 11/06/2026.
# POLLING_START="2026-06-11T00:00:00.000Z"

# ─── App ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"
