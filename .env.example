# ─── Banco de dados (Neon / Supabase / Postgres local) ───
DATABASE_URL="postgresql://user:password@localhost:5432/bolao?schema=public"

# ─── Auth.js (NextAuth v5) ───
# Gere um segredo com: npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-forte"
# Em produção defina a URL pública (ex.: https://bolao2026.com)
# AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Football-Data.org ───
# Competição Copa do Mundo: id 2000  (http://api.football-data.org/v4/competitions/)
FOOTBALL_DATA_TOKEN="IREI COLOCAR NO ENV"
FOOTBALL_DATA_COMPETITION_ID="2000"

# ─── Cron (protege os endpoints /api/cron/*) ───
CRON_SECRET="troque-por-um-segredo-de-cron"
# Data (ISO 8601 UTC) a partir da qual o cron começa a sincronizar/pontuar.
# Antes disso a rota retorna cedo sem chamar a API. Padrão: 11/06/2026.
# POLLING_START="2026-06-11T00:00:00.000Z"

# ─── App ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"
